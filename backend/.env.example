# Copy this file to .env and fill in real values. Every variable below is
# actually read somewhere in the codebase (confirmed by a full grep of
# process.env usage) — this file exists specifically so a fresh deploy
# doesn't have to reverse-engineer required config from source.

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000

# ── Database ────────────────────────────────────────────────────────────
MONGODB_URI=
# Some legacy/one-off scripts read MONGO_URI instead — keep both in sync if set
MONGO_URI=

# ── Auth ────────────────────────────────────────────────────────────────
# Must be at least 32 characters — server.js refuses to boot otherwise
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── AWS S3 (image/document storage) ────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=

# ── Cloudinary (legacy/secondary image storage) ────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Zoho Books integration ──────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=

# ── Email (Microsoft Graph API — not SMTP/nodemailer) ──────────────────
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Must be a real, licensed mailbox in the tenant above
GRAPH_SENDER_EMAIL=
SMTP_FROM_NAME=Quotation System

# ── PDF generation (Puppeteer) ──────────────────────────────────────────
# Only needed if Chromium isn't at the default /usr/bin/chromium path
CHROMIUM_PATH=
PDF_MAX_CONCURRENT=3
PDF_MAX_QUEUE=50

# ── Redis (optional response/query caching — app runs fine without it) ─
REDIS_URL=

# ── Logging ─────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── One-off scripts ─────────────────────────────────────────────────────
# Used only by scripts/seedCompanies.js: skip | replace | add
SEED_ACTION=skip
